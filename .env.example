# PostgreSQL — local development
POSTGRES_USER=aiops_user
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=aiops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JWT authentication — replace before running the backend
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery / Redis — local development
CELERY_BROKER_URL=redis://localhost:6379/1


# GenAI configuration
BEDROCK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=